# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=crm_user
DB_PASSWORD=changeme
DB_NAME=crm_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080

# Kafka (Redpanda) — internal port is 9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ORDERS=order_events
KAFKA_GROUP_ID=analytics-service
KAFKA_ADVERTISED_HOST=kafka

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=secret

# Auth
SALT=some_random_salt_value
JWT_SECRET=your_jwt_secret_key_change_in_production
